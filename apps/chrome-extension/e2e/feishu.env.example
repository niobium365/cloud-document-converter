# Use disposable documents only: the paste feature replaces content from the cursor onward.
FEISHU_E2E_DOCX_URL=https://your-tenant.feishu.cn/docx/your-disposable-docx-token
FEISHU_E2E_WIKI_URL=https://your-tenant.feishu.cn/wiki/your-disposable-wiki-token

# Optional. Defaults to apps/chrome-extension/.e2e/feishu-profile.
FEISHU_E2E_PROFILE_DIR=.e2e/feishu-profile
